# Copy this file to `.env` and fill in your values. `.env` is gitignored — your
# real key never gets committed. The wrapper (src/llm.py) reads these three vars.
#
# NOTE: put your REAL key only in `.env`, never in this file. This `.env.example`
# is committed to git, so it must only ever contain the placeholder below.

# --- Default provider: Groq (free, no credit card, OpenAI-compatible) ---
# Get a free key at https://console.groq.com/keys
LLM_API_KEY=gsk_your_free_groq_key_here

# The OpenAI-compatible endpoint. Groq's is below. To switch providers, change
# only this URL + the key + the model (all OpenAI-compatible):
#   OpenRouter: https://openrouter.ai/api/v1
#   Mistral:    https://api.mistral.ai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.groq.com/openai/v1

# A current Groq model available on the FREE tier (verified 2026-09-23).
# Stronger free alternative: openai/gpt-oss-120b. Also free: qwen/qwen3.8-27b.
# (The big Llama models exist but need a higher Groq tier — they 404 on free keys.)
LLM_MODEL=openai/gpt-oss-20b
