# Python virtual environment
venv/
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/

# Environment / secrets (API keys for the hosted LLM, added in a later checkpoint)
.env
# Any provider-specific backups (.env.groq, .env.gemini, ...) hold real keys too.
.env.*
!.env.example

# Large / derived data (MITRE ATT&CK STIX download + the built search index).
# All of it is rebuildable from scripts, so we don't commit it.
data/*.json
data/lancedb/
data/llm_cache/

# But DO keep the sample_logs.json test set (it lives at the repo root, not in data/)
# and keep the data/ folder itself around via a placeholder.
!data/.gitkeep

# macOS noise
.DS_Store
